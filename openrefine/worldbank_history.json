[
  {
    "op": "core/column-reorder",
    "columnNames": [
      "Country Name",
      "Country Code",
      "2017",
      "2018",
      "2019",
      "2020",
      "2021",
      "2022",
      "2023",
      "2024",
      "2025"
    ],
    "description": "Reorder columns"
  },
  {
    "op": "core/text-transform",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "Country Name",
    "expression": "value.trim()",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Text transform on cells in column Country Name using expression value.trim()"
  },
  {
    "op": "core/row-removal",
    "engineConfig": {
      "facets": [
        {
          "type": "list",
          "name": "Country Code",
          "expression": "grel:inArray([\"AFE\", \"AFW\", \"ARB\", \"CEB\", \"CSS\", \"EAP\", \"EAR\", \"EAS\", \"ECA\", \"ECS\", \"EMU\", \"EUU\", \"FCV\", \"HIC\", \"HPC\", \"IBD\", \"IBT\", \"IDA\", \"IDB\", \"IDX\", \"INX\", \"LAC\", \"LCN\", \"LIC\", \"LDC\", \"LMC\", \"LMY\", \"LTE\", \"MEA\", \"MIC\", \"MNA\", \"NAC\", \"OED\", \"OSS\", \"PRE\", \"PSS\", \"PST\", \"SAS\", \"SSA\", \"SSF\", \"SST\", \"TEA\", \"TEC\", \"TLA\", \"TMN\", \"TSA\", \"TSS\", \"UMC\", \"WLD\"], value)",
          "columnName": "Country Code",
          "invert": false,
          "omitBlank": false,
          "omitError": false,
          "selection": [
            {
              "v": {
                "v": true,
                "l": "true"
              }
            }
          ],
          "selectBlank": false,
          "selectError": false
        }
      ],
      "mode": "row-based"
    },
    "description": "Remove rows"
  },
  {
    "op": "core/transpose-columns-into-rows",
    "startColumnName": "2017",
    "columnCount": 9,
    "ignoreBlankCells": true,
    "fillDown": true,
    "separator": null,
    "keyColumnName": "Year",
    "valueColumnName": "TertiaryEnrollment",
    "description": "Transpose cells in 9 column(s) starting with 2017 into rows in two new columns named Year and TertiaryEnrollment"
  },
  {
    "op": "core/text-transform",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "Year",
    "expression": "value.toNumber()",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Text transform on cells in column Year using expression value.toNumber()"
  },
  {
    "op": "core/text-transform",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "TertiaryEnrollment",
    "expression": "value.toNumber()",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Text transform on cells in column TertiaryEnrollment using expression value.toNumber()"
  },
  {
    "op": "core/row-removal",
    "engineConfig": {
      "facets": [
        {
          "type": "list",
          "name": "TertiaryEnrollment",
          "expression": "isBlank(value)",
          "columnName": "TertiaryEnrollment",
          "invert": false,
          "omitBlank": false,
          "omitError": false,
          "selection": [
            {
              "v": {
                "v": true,
                "l": "true"
              }
            }
          ],
          "selectBlank": false,
          "selectError": false
        }
      ],
      "mode": "row-based"
    },
    "description": "Remove rows"
  }
]